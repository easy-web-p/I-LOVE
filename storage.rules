rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Validate file sizes and MIME types (Section 24)
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    function isValidAudio() {
      return request.resource.size < 25 * 1024 * 1024 &&
             request.resource.contentType.matches('audio/.*');
    }

    function isValidVideo() {
      return request.resource.size < 100 * 1024 * 1024 &&
             request.resource.contentType.matches('video/.*');
    }

    // Public published assets (Thumbnails, optimized web photos)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Uploaded via server functions
    }

    // User media storage
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.auth.uid == userId && 
                   (isValidImage() || isValidAudio() || isValidVideo());
    }

    // Template public assets
    match /templates/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
